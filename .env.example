# ==============================================================================
# Environment Configuration Template
# Duplicate this file as .env and fill in your confidential credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Secrets
# ------------------------------------------------------------------------------
# Discord Bot Token (from Discord Developer Portal -> Bot -> Token)
TOKEN=your_discord_bot_token_here

# PostgreSQL Database Connection URL (e.g. Neon Serverless, Supabase, or local)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://username:password@your-database-host.com/dbname?sslmode=require

# ------------------------------------------------------------------------------
# Application Environment Mode
# ------------------------------------------------------------------------------
# 'prod' for production channels and standard intervals (1.5h - 3.0h)
# 'dev' for development channels and rapid test intervals (10s - 20s)
ENV=prod

# Optional Port for Keep-Alive Web Server (defaults to 8080 if omitted)
PORT=8080

# ------------------------------------------------------------------------------
# Discord Channels (Snowflake IDs)
# ------------------------------------------------------------------------------
# Production Event Channels mapped to instances i1, i2, and i3
CANAL_I1_ID=111111111111111111
CANAL_I2_ID=222222222222222222
CANAL_I3_ID=333333333333333333

# Development Channels (optional: used when ENV=dev; falls back to production IDs if omitted)
DEV_CANAL_I1_ID=444444444444444444
DEV_CANAL_I2_ID=555555555555555555
DEV_CANAL_I3_ID=666666666666666666

# ------------------------------------------------------------------------------
# Discord Roles (Snowflake IDs)
# ------------------------------------------------------------------------------
# Role pinged when announcing game events
ROL_AVISO_ID=777777777777777777
DEV_ROL_AVISO_ID=777777777777777777

# Staff role permitted to execute administrative commands (setinstancia, spawn, etc.)
ROL_STAFF_ID=888888888888888888
DEV_ROL_STAFF_ID=888888888888888888

# ------------------------------------------------------------------------------
# Customization
# ------------------------------------------------------------------------------
# Currency emoji: accepts standard Unicode (e.g. 🪙) or Discord custom emoji format (<:name:id>)
EMOJI_KAKERA=🪙

# Embed footer branding
FOOTER_TEXT=Copyright (©) Casino Club
FOOTER_ICON=https://i.imgur.com/ytopJtE.gif
